{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "lib/**/*",
    "test/**/*"
  ],
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "module": "esnext",
    "target": "ES2022",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": [
      "node"
    ]
  }
}
